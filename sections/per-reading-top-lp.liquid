{% comment %}
  PER Reading Top LP (Dawn compatible)
{% endcomment %}

<section class="per-lp color-{{ section.settings.color_scheme }}" id="per-lp-{{ section.id }}">
  <div class="per-lp__bg-glow per-lp__bg-glow--left" aria-hidden="true"></div>
  <div class="per-lp__bg-glow per-lp__bg-glow--right" aria-hidden="true"></div>

  <div class="per-lp__inner page-width">
    <header class="per-lp__hero per-lp__panel">
      <div class="per-lp__hero-kirakira" aria-hidden="true"></div>
      <div class="per-lp__hero-content">
        <p class="per-lp__eyebrow">{{ section.settings.eyebrow }}</p>
        <h1 class="per-lp__title">{{ section.settings.title }}</h1>
        <p class="per-lp__subtitle">{{ section.settings.subtitle }}</p>
        <div class="per-lp__cta-wrap">
          <a href="{{ section.settings.primary_button_link }}" class="per-lp__button per-lp__button--primary">{{ section.settings.primary_button_label }}</a>
          <a href="{{ section.settings.secondary_button_link }}" class="per-lp__button per-lp__button--ghost">{{ section.settings.secondary_button_label }}</a>
        </div>
      </div>
      {% if section.settings.hero_couple_image != blank %}
        <img class="per-lp__hero-couple" src="{{ section.settings.hero_couple_image | image_url: width: 900 }}" alt="" loading="lazy" width="500" height="650">
      {% endif %}
    </header>

    <section class="per-lp__diagnosis-flow per-lp__panel" id="diagnosis-{{ section.id }}">
      <h2 class="per-lp__section-title">{{ section.settings.diagnosis_heading }}</h2>
      <p class="per-lp__section-text">{{ section.settings.diagnosis_text }}</p>
      <ul class="per-lp__steps" role="list">
        {% for block in section.blocks %}
          {% if block.type == 'step' %}
            <li class="per-lp__step" {{ block.shopify_attributes }}>
              <span class="per-lp__step-number">{{ forloop.index }}</span>
              <div>
                <h3 class="per-lp__step-title">{{ block.settings.title }}</h3>
                <p class="per-lp__step-text">{{ block.settings.text }}</p>
              </div>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </section>

    <section class="per-lp__birthform per-lp__panel">
      <h2 class="per-lp__section-title">生年月日で運命を読む</h2>
      <form class="per-lp__form" action="#" method="post" onsubmit="return false;">
        <label class="per-lp__field"><span>あなたの生年月日</span><input type="date" name="your_birthdate"></label>
        <label class="per-lp__field"><span>お相手の生年月日</span><input type="date" name="partner_birthdate"></label>
        <button type="submit" class="per-lp__button per-lp__button--primary per-lp__button--full">{{ section.settings.diagnosis_button_label }}</button>
      </form>
    </section>

    <section class="per-lp__compatibility per-lp__panel">
      <h2 class="per-lp__section-title">相性結果プレビュー</h2>
      <div class="per-lp__result-cards">
        <article class="per-lp__result-card"><h3>恋愛シンクロ率</h3><p class="score">89%</p><p>感情の波長が近く、自然体で惹かれ合う関係。</p></article>
        <article class="per-lp__result-card"><h3>結婚運バランス</h3><p class="score">A+</p><p>価値観の擦り合わせがしやすく、安定した未来像。</p></article>
        <article class="per-lp__result-card"><h3>運命の転機</h3><p class="score">7月</p><p>対話が深まる季節。関係進展のチャンスが強まります。</p></article>
      </div>
    </section>

    <section class="per-lp__radar per-lp__panel">
      <h2 class="per-lp__section-title">恋愛エネルギー・レーダー</h2>
      <div class="per-lp__radar-wrap">
        <div class="per-lp__radar-chart" aria-hidden="true"></div>
        <ul class="per-lp__legend" role="list">
          <li>情熱 92</li><li>信頼 84</li><li>相性 89</li><li>将来性 86</li><li>精神共鳴 90</li>
        </ul>
      </div>
    </section>

    <section class="per-lp__pricing per-lp__panel">
      <h2 class="per-lp__section-title">鑑定メニュー</h2>
      <div class="per-lp__price-grid">
        <article class="per-lp__price-card"><p class="plan">Light</p><h3>無料診断</h3><p class="price">¥0</p><p>相性の核を1分でチェック。</p></article>
        <article class="per-lp__price-card per-lp__price-card--featured"><p class="plan">Premium</p><h3>恋愛成就鑑定</h3><p class="price">¥4,980</p><p>深層心理、時期、行動アドバイス付き。</p></article>
        <article class="per-lp__price-card"><p class="plan">Royal</p><h3>完全個別セッション</h3><p class="price">¥12,000</p><p>2人の未来地図を丁寧に読み解く特別版。</p></article>
      </div>
      <a href="{{ section.settings.offer_button_link }}" class="per-lp__button per-lp__button--gold per-lp__button--full">{{ section.settings.offer_button_label }}</a>
    </section>
  </div>
</section>

<style>
#per-lp-{{ section.id }} { --bg1:#20122f; --bg2:#3a2758; --pink:#f7c7ec; --lav:#d7cbff; --gold:#f8dea2; --text:#fdf9ff; --muted:#e8dcf9; background:radial-gradient(160% 120% at 0% 0%, #5f4793 0%, var(--bg1) 58%, #130d23 100%); color:var(--text); padding:40px 0 70px; position:relative; overflow:hidden; }
#per-lp-{{ section.id }} .per-lp__inner{display:grid;gap:20px;position:relative;z-index:2}
#per-lp-{{ section.id }} .per-lp__panel{background:linear-gradient(160deg, rgba(255,255,255,.13), rgba(255,255,255,.04));border:1px solid rgba(255,231,188,.35);backdrop-filter:blur(15px) saturate(130%);border-radius:28px;padding:24px;box-shadow:0 15px 45px rgba(11,6,26,.45), inset 0 1px 0 rgba(255,255,255,.3)}
#per-lp-{{ section.id }} .per-lp__hero{display:grid;gap:16px;position:relative;overflow:hidden}
#per-lp-{{ section.id }} .per-lp__hero-kirakira{position:absolute;inset:0;background:radial-gradient(circle at 12% 18%, rgba(255,236,183,.26) 0 2px, transparent 2px),radial-gradient(circle at 75% 70%, rgba(235,194,255,.33) 0 2px, transparent 2px);opacity:.7}
#per-lp-{{ section.id }} .per-lp__hero-couple{width:min(220px,56vw);justify-self:end;filter:drop-shadow(0 6px 20px rgba(0,0,0,.35))}
#per-lp-{{ section.id }} .per-lp__eyebrow{color:var(--gold);letter-spacing:.11em;margin:0}
#per-lp-{{ section.id }} .per-lp__title{font-size:clamp(2.5rem,8.8vw,4.6rem);margin:.4rem 0 1rem;line-height:1.24}
#per-lp-{{ section.id }} .per-lp__subtitle,#per-lp-{{ section.id }} .per-lp__section-text,#per-lp-{{ section.id }} p{color:var(--muted);line-height:1.8}
#per-lp-{{ section.id }} .per-lp__section-title{color:var(--lav);font-size:clamp(2rem,5.4vw,3rem);margin:0 0 10px}
#per-lp-{{ section.id }} .per-lp__cta-wrap{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
#per-lp-{{ section.id }} .per-lp__button{border-radius:999px;min-height:48px;padding:11px 20px;text-decoration:none;font-weight:700;display:inline-flex;align-items:center;justify-content:center;transition:.25s}
#per-lp-{{ section.id }} .per-lp__button:hover{transform:translateY(-2px)}
#per-lp-{{ section.id }} .per-lp__button--primary{background:linear-gradient(130deg,#f2b9ff 0%,#f8de97 55%,#dca3ff 100%);color:#321d4a;box-shadow:0 0 30px rgba(248,210,255,.45)}
#per-lp-{{ section.id }} .per-lp__button--ghost{border:1px solid rgba(226,211,255,.65);color:var(--lav);background:rgba(255,255,255,.05)}
#per-lp-{{ section.id }} .per-lp__button--gold{background:linear-gradient(132deg,#fff4cf 0%,#ffdb95 46%,#ffd6f5 100%);color:#2d1b43;box-shadow:0 0 36px rgba(255,220,158,.4)}
#per-lp-{{ section.id }} .per-lp__button--full{width:100%;margin-top:14px}
#per-lp-{{ section.id }} .per-lp__steps{list-style:none;padding:0;margin:14px 0 0;display:grid;gap:10px}
#per-lp-{{ section.id }} .per-lp__step{display:grid;grid-template-columns:auto 1fr;gap:10px;border:1px solid rgba(248,219,168,.24);border-radius:16px;padding:12px;background:rgba(24,14,38,.44)}
#per-lp-{{ section.id }} .per-lp__step-number{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;color:#2f1d47;background:linear-gradient(145deg,#ffeebf,#d7a85b);font-weight:700}
#per-lp-{{ section.id }} .per-lp__field{display:grid;gap:6px;margin-bottom:12px}
#per-lp-{{ section.id }} .per-lp__field input{border-radius:14px;border:1px solid rgba(238,222,255,.4);background:rgba(255,255,255,.08);color:var(--text);padding:12px}
#per-lp-{{ section.id }} .per-lp__result-cards,#per-lp-{{ section.id }} .per-lp__price-grid{display:grid;gap:12px}
#per-lp-{{ section.id }} .per-lp__result-card,#per-lp-{{ section.id }} .per-lp__price-card{border-radius:20px;padding:16px;border:1px solid rgba(245,224,255,.35);background:linear-gradient(160deg, rgba(255,255,255,.15), rgba(255,255,255,.03))}
#per-lp-{{ section.id }} .score{font-size:2.6rem;line-height:1.1;color:var(--gold);margin:6px 0 4px}
#per-lp-{{ section.id }} .per-lp__radar-wrap{display:grid;gap:14px;align-items:center}
#per-lp-{{ section.id }} .per-lp__radar-chart{width:220px;height:220px;justify-self:center;border-radius:50%;background:radial-gradient(circle at center, rgba(255,255,255,.18), rgba(255,255,255,.05)),conic-gradient(from 0deg, rgba(245,205,255,.7), rgba(255,226,170,.8), rgba(212,201,255,.75), rgba(245,205,255,.7));mask:radial-gradient(circle, transparent 0 36%, #000 37%);box-shadow:0 0 42px rgba(248,206,255,.35)}
#per-lp-{{ section.id }} .per-lp__legend{list-style:none;margin:0;padding:0;display:grid;gap:6px}
#per-lp-{{ section.id }} .plan{color:var(--gold);margin:0}
#per-lp-{{ section.id }} .price{font-size:2.4rem;color:var(--lav);margin:4px 0}
#per-lp-{{ section.id }} .per-lp__price-card--featured{box-shadow:0 0 38px rgba(255,221,177,.35);border-color:rgba(255,233,196,.55)}
#per-lp-{{ section.id }} .per-lp__bg-glow{position:absolute;width:280px;height:280px;border-radius:50%;filter:blur(48px);opacity:.36}
#per-lp-{{ section.id }} .per-lp__bg-glow--left{top:-110px;left:-70px;background:#bc9bff}
#per-lp-{{ section.id }} .per-lp__bg-glow--right{bottom:-120px;right:-70px;background:#ffe095}
@media (min-width: 750px){
#per-lp-{{ section.id }}{padding:70px 0 90px}
#per-lp-{{ section.id }} .per-lp__inner{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}
#per-lp-{{ section.id }} .per-lp__hero{grid-column:1/-1;grid-template-columns:1.2fr .8fr;align-items:end}
#per-lp-{{ section.id }} .per-lp__result-cards{grid-template-columns:repeat(3,minmax(0,1fr))}
#per-lp-{{ section.id }} .per-lp__price-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media (max-width: 749px){
#per-lp-{{ section.id }} .per-lp__panel{padding:18px;border-radius:22px}
#per-lp-{{ section.id }} .per-lp__button{width:100%}
#per-lp-{{ section.id }} .per-lp__cta-wrap{display:grid;grid-template-columns:1fr}
}
</style>

{% schema %}
{
  "name": "PER Reading Top LP",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme_1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PER Reading | Premium Love Divination" },
    { "type": "text", "id": "title", "label": "Title", "default": "縁の糸を読み解く、高級恋愛鑑定" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "和の叡智とスピリチュアルリーディングで、あなたの恋の転機を静かに映し出します。" },
    { "type": "image_picker", "id": "hero_couple_image", "label": "Hero right image (couple silhouette)" },
    { "type": "text", "id": "primary_button_label", "label": "Primary button label", "default": "今すぐ鑑定を始める" },
    { "type": "url", "id": "primary_button_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_button_label", "label": "Secondary button label", "default": "診断の流れを見る" },
    { "type": "url", "id": "secondary_button_link", "label": "Secondary button link" },
    { "type": "text", "id": "diagnosis_heading", "label": "Diagnosis heading", "default": "3分でわかる恋愛相性診断" },
    { "type": "textarea", "id": "diagnosis_text", "label": "Diagnosis text", "default": "生年月日と今の想いを入力するだけ。あなたの恋が進む道筋を、淡く神秘的な言葉でお届けします。" },
    { "type": "text", "id": "diagnosis_button_label", "label": "Diagnosis CTA label", "default": "無料診断を試す" },
    { "type": "url", "id": "offer_button_link", "label": "Offer button link" },
    { "type": "text", "id": "offer_button_label", "label": "Offer button label", "default": "プレミアム鑑定へ進む" }
  ],
  "blocks": [
    {"type":"step","name":"Step","settings":[{"type":"text","id":"title","label":"Step title","default":"質問に回答"},{"type":"textarea","id":"text","label":"Step text","default":"恋愛状況や気になるお相手について、直感のままに入力します。"}]}
  ],
  "max_blocks": 4,
  "presets": [{"name":"PER Reading Top LP","blocks":[{"type":"step","settings":{"title":"恋の現状を入力","text":"あなたとお相手の関係性、今抱えている想いを丁寧に入力。"}},{"type":"step","settings":{"title":"和風スピリチュアル解析","text":"霊感タロットと和の象徴を掛け合わせ、深層心理を読み解きます。"}},{"type":"step","settings":{"title":"結果と開運アドバイス","text":"恋が動く時期・行動のヒント・二人の未来像を受け取れます。"}}]}]
}
{% endschema %}
