{% assign sid = section.id %}
<section id="per-reading-{{ sid }}" class="per-reading-wrap color-{{ section.settings.color_scheme }}" data-per-app>
  <div class="per-reading-bg-orb per-reading-bg-orb--a" aria-hidden="true"></div>
  <div class="per-reading-bg-orb per-reading-bg-orb--b" aria-hidden="true"></div>
  <div class="per-reading-bg-orb per-reading-bg-orb--c" aria-hidden="true"></div>

  <div class="per-reading-shell page-width">
    <section class="per-reading-hero per-reading-glass">
      <div class="per-reading-hero__col per-reading-hero__left">
        <p class="per-reading-kicker">{{ section.settings.eyebrow }}</p>
        <h1>{{ section.settings.title }}</h1>
        <p class="per-reading-subtitle">{{ section.settings.subtitle }}</p>

        <div class="per-reading-chiprow">
          <span class="per-reading-chip">60干支循環</span>
          <span class="per-reading-chip">位相法相性</span>
          <span class="per-reading-chip">宇宙盤分析</span>
        </div>

        <div class="per-reading-hero__ctas">
          <a class="per-reading-btn per-reading-btn--gold" href="{{ section.settings.primary_button_link }}">{{ section.settings.primary_button_label }}</a>
          <a class="per-reading-btn per-reading-btn--line" href="#per-reading-diagnosis-{{ sid }}">{{ section.settings.secondary_button_label }}</a>
        </div>
      </div>

      <div class="per-reading-hero__col per-reading-hero__center per-reading-glass-soft">
        <canvas id="per-reading-circle-{{ sid }}" width="360" height="360" aria-label="PER 60干支円" data-per-circle></canvas>
        <p class="per-reading-mini">日干支の重心を可視化し、関係性の距離と共鳴を読み解きます。</p>
      </div>

      <aside class="per-reading-hero__col per-reading-hero__right per-reading-glass-soft">
        <h3>無料PER診断</h3>
        <p>生年月日 × 5問の直感回答で、PERタイプ・相性・行動領域を同時解析。</p>
        <button class="per-reading-btn per-reading-btn--pink" data-per-start>無料診断を開始</button>
      </aside>
    </section>

    <section id="per-reading-diagnosis-{{ sid }}" class="per-reading-diagnosis per-reading-glass" data-per-diagnosis>
      <div class="per-reading-headline">
        <h2>診断セッション</h2>
        <p>あなたとお相手の生年月日を入力し、設問に答えてください。</p>
      </div>

      <div class="per-reading-formrow">
        <label>あなたの生年月日
          <input type="date" data-per-self-dob>
        </label>
        <label>お相手の生年月日
          <input type="date" data-per-partner-dob>
        </label>
        <label>性別
          <select data-per-gender>
            <option value="female">女性</option>
            <option value="male">男性</option>
            <option value="other">その他</option>
          </select>
        </label>
      </div>

      <div class="per-reading-question-card">
        <div class="per-reading-question" data-per-question></div>
        <div class="per-reading-ab">
          <button class="per-reading-btn per-reading-btn--line" data-per-answer="A">Aを選択</button>
          <button class="per-reading-btn per-reading-btn--line" data-per-answer="B">Bを選択</button>
        </div>
      </div>

      <div class="per-reading-progress"><span data-per-progress></span></div>
      <button class="per-reading-btn per-reading-btn--gold per-reading-next" data-per-next>次へ</button>
      <p class="per-reading-feedback" data-per-feedback hidden></p>
    </section>

    <section class="per-reading-results per-reading-glass" data-per-result hidden>
      <h2>PER診断結果</h2>
      <div class="per-reading-grid2">
        <article class="per-reading-card">
          <h3 data-per-type-title>PERタイプ</h3>
          <p data-per-type-feature></p>
          <p data-per-type-strength></p>
          <p data-per-type-caution></p>
        </article>
        <article class="per-reading-card per-reading-card--paper">
          <h3>鑑定書</h3>
          <p data-per-report></p>
        </article>
      </div>
    </section>

    <section class="per-reading-compat per-reading-glass" data-per-compat hidden>
      <h2>相性診断結果</h2>
      <div class="per-reading-grid2">
        <div class="per-reading-card">
          <p class="per-reading-score" data-per-compat-score></p>
          <h3 data-per-compat-type></h3>
          <p data-per-compat-text></p>
        </div>
        <div class="per-reading-card per-reading-sil">
          {% if section.settings.silhouette_image != blank %}
            <img src="{{ section.settings.silhouette_image | image_url: width: 800 }}" alt="男女シルエット" loading="lazy">
          {% endif %}
        </div>
      </div>
    </section>

    <section class="per-reading-universe per-reading-glass-dark" data-per-universe hidden>
      <h2>宇宙盤・行動領域診断</h2>
      <p>6領域バランスを可視化し、今の開運アクションを提示します。</p>
      <canvas id="per-reading-radar-{{ sid }}" width="340" height="340" data-per-radar></canvas>
    </section>

    <section class="per-reading-menu per-reading-glass">
      <h2>鑑定メニュー</h2>
      <div class="per-reading-grid5">
        {% for i in (1..5) %}
          {% assign t = 'menu_title_' | append: i %}
          {% assign p = 'menu_price_' | append: i %}
          {% assign l = 'menu_link_' | append: i %}
          <a class="per-reading-card per-reading-price" href="{{ section.settings[l] }}">
            <h3>{{ section.settings[t] }}</h3>
            <p>{{ section.settings[p] }}</p>
          </a>
        {% endfor %}
      </div>
    </section>

    <section class="per-reading-products per-reading-glass">
      <h2>おすすめ商品</h2>
      <div class="per-reading-grid3">
        {% for i in (1..3) %}
          {% assign product_setting = 'featured_product_' | append: i %}
          {% assign product = section.settings[product_setting] %}
          {% if product != blank %}
            <article class="per-reading-card per-reading-product">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
              {% endif %}
              <h3>{{ product.title }}</h3>
              <p>{{ product.price | money }}</p>
              <a class="per-reading-btn per-reading-btn--gold" href="{{ product.url }}">詳細を見る</a>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>

    <section class="per-reading-share per-reading-glass">
      <h2>SNS共有</h2>
      <div class="per-reading-sharebtns">
        <button data-per-share="line">LINE</button>
        <button data-per-share="x">X</button>
        <button data-per-share="instagram">Instagram</button>
        <button data-per-copy>リンクをコピー</button>
      </div>
    </section>

    <footer class="per-reading-foot per-reading-glass-soft">
      <h3>PER Reading</h3>
      <p>{{ section.settings.footer_text }}</p>
      <small>本鑑定は娯楽・自己理解を目的としたコンテンツです。</small>
    </footer>
  </div>
</section>

<style>
#per-reading-{{ sid }}{position:relative;overflow:hidden;background:radial-gradient(circle at 10% 5%,#ffffff 0,#f8f2ff 40%,#fdeff8 72%,#fffdf8 100%);padding:26px 0 48px;color:#2f2040}
#per-reading-{{ sid }} .per-reading-bg-orb{position:absolute;border-radius:50%;filter:blur(4px);pointer-events:none}
#per-reading-{{ sid }} .per-reading-bg-orb--a{width:180px;height:180px;background:radial-gradient(circle,#f2cfff 0,rgba(242,207,255,.05) 70%);top:-30px;left:-40px}
#per-reading-{{ sid }} .per-reading-bg-orb--b{width:220px;height:220px;background:radial-gradient(circle,#ffe9f5 0,rgba(255,233,245,.04) 70%);right:-60px;top:120px}
#per-reading-{{ sid }} .per-reading-bg-orb--c{width:220px;height:220px;background:radial-gradient(circle,#fce8b7 0,rgba(252,232,183,.05) 72%);left:38%;bottom:-80px}
#per-reading-{{ sid }} .per-reading-shell{position:relative;display:grid;gap:16px;z-index:2}
#per-reading-{{ sid }} .per-reading-glass{background:rgba(255,255,255,.64);backdrop-filter:blur(16px);border:1px solid rgba(227,196,255,.42);border-radius:24px;padding:18px;box-shadow:0 10px 36px rgba(111,73,144,.11)}
#per-reading-{{ sid }} .per-reading-glass-soft{background:rgba(255,255,255,.56);border:1px solid rgba(227,196,255,.35);border-radius:20px;padding:16px}
#per-reading-{{ sid }} .per-reading-glass-dark{background:linear-gradient(180deg,#2a2452 0,#131735 100%);color:#fff;border:1px solid rgba(246,218,255,.24);border-radius:24px;padding:18px;text-align:center}
#per-reading-{{ sid }} h1,#per-reading-{{ sid }} h2,#per-reading-{{ sid }} h3{margin:.2em 0 .5em}
#per-reading-{{ sid }} h1{font-size:clamp(1.65rem,5vw,2.4rem);line-height:1.25}
#per-reading-{{ sid }} .per-reading-kicker{font-size:.78rem;letter-spacing:.16em;color:#9e74c5;text-transform:uppercase}
#per-reading-{{ sid }} .per-reading-subtitle{color:#5b4970;line-height:1.8}
#per-reading-{{ sid }} .per-reading-chiprow{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0 14px}
#per-reading-{{ sid }} .per-reading-chip{font-size:.74rem;padding:6px 10px;border-radius:999px;background:rgba(255,255,255,.88);border:1px solid #e8d2ff;color:#6e5390}
#per-reading-{{ sid }} .per-reading-btn{border:0;border-radius:999px;padding:12px 18px;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:.2s transform,.2s opacity}
#per-reading-{{ sid }} .per-reading-btn:hover{transform:translateY(-1px);opacity:.96}
#per-reading-{{ sid }} .per-reading-btn--gold{background:linear-gradient(135deg,#fff8d8,#f2d08b,#f8e6f5);color:#3b2a47}
#per-reading-{{ sid }} .per-reading-btn--pink{background:linear-gradient(135deg,#ffe7f3,#edd8ff);color:#402d52}
#per-reading-{{ sid }} .per-reading-btn--line{background:rgba(255,255,255,.95);border:1px solid #dbc1f8;color:#4f3b65}
#per-reading-{{ sid }} .per-reading-hero{display:grid;gap:12px}
#per-reading-{{ sid }} .per-reading-hero__ctas{display:flex;gap:10px;flex-wrap:wrap}
#per-reading-{{ sid }} .per-reading-mini{font-size:.9rem;line-height:1.8;color:#5c4a72;text-align:center}
#per-reading-{{ sid }} .per-reading-headline p{margin:0;color:#645278}
#per-reading-{{ sid }} .per-reading-formrow{display:grid;gap:10px;margin-top:10px}
#per-reading-{{ sid }} input,#per-reading-{{ sid }} select{width:100%;padding:12px;border:1px solid #e0c8fc;border-radius:12px;background:#fff;color:#3d2f4b}
#per-reading-{{ sid }} .per-reading-question-card{margin-top:12px;background:rgba(255,255,255,.84);border:1px solid #ead8ff;border-radius:16px;padding:12px}
#per-reading-{{ sid }} .per-reading-question{font-weight:700;line-height:1.8;margin-bottom:10px}
#per-reading-{{ sid }} .per-reading-ab{display:grid;grid-template-columns:1fr 1fr;gap:8px}
#per-reading-{{ sid }} [data-per-answer].is-selected{box-shadow:0 0 0 2px #c79bff inset;background:#f9f1ff}
#per-reading-{{ sid }} .per-reading-progress{margin-top:12px;height:8px;background:#f1e6fd;border-radius:999px;overflow:hidden}
#per-reading-{{ sid }} .per-reading-progress span{display:block;height:100%;width:0;background:linear-gradient(90deg,#ca9eff,#f8cf9d)}
#per-reading-{{ sid }} .per-reading-next{margin-top:12px;width:100%}
#per-reading-{{ sid }} .per-reading-feedback{margin:.65rem 0 0;color:#8a2f60;font-weight:600;font-size:.88rem}
#per-reading-{{ sid }} .per-reading-grid2,#per-reading-{{ sid }} .per-reading-grid3,#per-reading-{{ sid }} .per-reading-grid5{display:grid;gap:10px}
#per-reading-{{ sid }} .per-reading-card{background:rgba(255,255,255,.85);border-radius:16px;padding:14px;border:1px solid #eddfff}
#per-reading-{{ sid }} .per-reading-card--paper{background:linear-gradient(180deg,#fff9ef,#fff)}
#per-reading-{{ sid }} .per-reading-score{font-size:2.2rem;font-weight:800;color:#8a5ab7}
#per-reading-{{ sid }} .per-reading-price p{font-size:1.2rem;font-weight:800;color:#6a4a8e}
#per-reading-{{ sid }} .per-reading-product img{width:100%;height:auto;border-radius:12px;margin-bottom:10px}
#per-reading-{{ sid }} .per-reading-sil img{max-width:100%;height:auto;border-radius:14px}
#per-reading-{{ sid }} .per-reading-sharebtns{display:flex;gap:8px;flex-wrap:wrap}
#per-reading-{{ sid }} .per-reading-sharebtns button{border:1px solid #dcc7f7;background:#fff;padding:9px 14px;border-radius:999px;color:#543f6f}

@media(min-width:990px){
  #per-reading-{{ sid }}{padding:38px 0 64px}
  #per-reading-{{ sid }} .per-reading-hero{grid-template-columns:1.1fr 1fr .85fr;align-items:center;gap:14px}
  #per-reading-{{ sid }} .per-reading-formrow{grid-template-columns:repeat(3,1fr)}
  #per-reading-{{ sid }} .per-reading-grid2{grid-template-columns:repeat(2,1fr)}
  #per-reading-{{ sid }} .per-reading-grid3{grid-template-columns:repeat(3,1fr)}
  #per-reading-{{ sid }} .per-reading-grid5{grid-template-columns:repeat(5,1fr)}
}
</style>

{{ 'per-reading-app.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "PER Reading Top LP",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme_1"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"PER Reading | Premium"},
    {"type":"text","id":"title","label":"Title","default":"高級占いWebアプリ PER Reading"},
    {"type":"textarea","id":"subtitle","label":"Subtitle","default":"60干支円・相性位相法・宇宙盤を統合した診断UI。"},
    {"type":"text","id":"primary_button_label","label":"Primary button label","default":"無料診断を始める"},
    {"type":"url","id":"primary_button_link","label":"Primary button link"},
    {"type":"text","id":"secondary_button_label","label":"Secondary button label","default":"診断の仕組みを見る"},
    {"type":"image_picker","id":"silhouette_image","label":"Couple silhouette image"},
    {"type":"product","id":"featured_product_1","label":"Featured product 1"},
    {"type":"product","id":"featured_product_2","label":"Featured product 2"},
    {"type":"product","id":"featured_product_3","label":"Featured product 3"},
    {"type":"text","id":"menu_title_1","label":"Menu 1 title","default":"詳細PER鑑定書"},
    {"type":"text","id":"menu_price_1","label":"Menu 1 price","default":"¥4,980"},
    {"type":"url","id":"menu_link_1","label":"Menu 1 link"},
    {"type":"text","id":"menu_title_2","label":"Menu 2 title","default":"恋愛未来鑑定"},
    {"type":"text","id":"menu_price_2","label":"Menu 2 price","default":"¥6,800"},
    {"type":"url","id":"menu_link_2","label":"Menu 2 link"},
    {"type":"text","id":"menu_title_3","label":"Menu 3 title","default":"LINE個別鑑定"},
    {"type":"text","id":"menu_price_3","label":"Menu 3 price","default":"¥9,800"},
    {"type":"url","id":"menu_link_3","label":"Menu 3 link"},
    {"type":"text","id":"menu_title_4","label":"Menu 4 title","default":"相性深掘り鑑定"},
    {"type":"text","id":"menu_price_4","label":"Menu 4 price","default":"¥8,800"},
    {"type":"url","id":"menu_link_4","label":"Menu 4 link"},
    {"type":"text","id":"menu_title_5","label":"Menu 5 title","default":"運命の流れ鑑定"},
    {"type":"text","id":"menu_price_5","label":"Menu 5 price","default":"¥12,000"},
    {"type":"url","id":"menu_link_5","label":"Menu 5 link"},
    {"type":"textarea","id":"footer_text","label":"Footer text","default":"PER Readingは和の占術データをもとに自己理解を促す診断サービスです。"}
  ],
  "presets":[{"name":"PER Reading Top LP"}]
}
{% endschema %}
